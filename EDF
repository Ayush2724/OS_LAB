#include <stdio.h>

int main() {
    int n, i, t;
    int burst[10], period[10], remain[10], deadline[10];

    printf("Enter number of tasks: ");
    scanf("%d",&n);

    for(i=0;i<n;i++) {
        printf("Burst and Period of Task %d: ",i+1);
        scanf("%d%d",&burst[i],&period[i]);
        remain[i]=0;
        deadline[i]=period[i];
    }

    for(t=0;t<20;t++) {

        for(i=0;i<n;i++) {
            if(t % period[i]==0) {
                remain[i]=burst[i];
                deadline[i]=t+period[i];
            }
        }

        int task=-1,min=9999;

        for(i=0;i<n;i++) {
            if(remain[i]>0 && deadline[i]<min) {
                min=deadline[i];
                task=i;
            }
        }

        if(task==-1)
            printf("Time %d : Idle\n",t);
        else {
            printf("Time %d : Task %d\n",t,task+1);
            remain[task]--;
        }
    }
}
