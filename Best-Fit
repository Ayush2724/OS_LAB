#include <stdio.h>

int main() {
    int block[10],process[10];
    int nb,np,i,j,best;

    scanf("%d",&nb);
    for(i=0;i<nb;i++) scanf("%d",&block[i]);

    scanf("%d",&np);
    for(i=0;i<np;i++) scanf("%d",&process[i]);

    for(i=0;i<np;i++) {
        best=-1;

        for(j=0;j<nb;j++)
            if(block[j]>=process[i])
                if(best==-1 || block[j]<block[best])
                    best=j;

        if(best!=-1) {
            printf("P%d -> Block %d\n",i+1,best+1);
            block[best]-=process[i];
        }
    }
}
