#include <stdio.h>

int main() {
    int i,n=5;

    for(i=0;i<n;i++) {
        printf("Philosopher %d is Thinking\n",i);
        printf("Philosopher %d takes Fork %d and %d\n",i,i,(i+1)%n);
        printf("Philosopher %d is Eating\n",i);
        printf("Philosopher %d puts Fork %d and %d\n\n",i,i,(i+1)%n);
    }

    return 0;
}
