#include <stdio.h>

int main() {
    int n,m,i,j;

    printf("Processes Resources: ");
    scanf("%d%d",&n,&m);

    int alloc[10][10], req[10][10], avail[10];
    int finish[10]={0};

    printf("Allocation Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&alloc[i][j]);

    printf("Request Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&req[i][j]);

    printf("Available:\n");
    for(i=0;i<m;i++)
        scanf("%d",&avail[i]);

    int count=0;

    while(count<n) {
        int found=0;

        for(i=0;i<n;i++) {
            if(!finish[i]) {
                int flag=1;

                for(j=0;j<m;j++)
                    if(req[i][j]>avail[j])
                        flag=0;

                if(flag) {
                    for(j=0;j<m;j++)
                        avail[j]+=alloc[i][j];

                    finish[i]=1;
                    found=1;
                    count++;
                }
            }
        }

        if(!found)
            break;
    }

    for(i=0;i<n;i++)
        if(!finish[i])
            printf("Deadlock detected at P%d\n",i);
}
