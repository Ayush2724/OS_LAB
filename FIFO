#include <stdio.h>

int main() {
    int pages[50], frame[10];
    int n,f,i,j,k=0,fault=0;

    printf("Pages: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&pages[i]);

    printf("Frames: ");
    scanf("%d",&f);

    for(i=0;i<f;i++)
        frame[i]=-1;

    for(i=0;i<n;i++) {

        int found=0;

        for(j=0;j<f;j++)
            if(frame[j]==pages[i])
                found=1;

        if(!found) {
            frame[k]=pages[i];
            k=(k+1)%f;
            fault++;
        }
    }

    printf("Page Faults=%d\n",fault);
}
