#include <stdio.h>

int main() {
    int alloc[10][10], max[10][10], need[10][10];
    int avail[10];
    int n,m,i,j,count=0;

    printf("Processes and Resources: ");
    scanf("%d%d",&n,&m);

    printf("Allocation Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&alloc[i][j]);

    printf("Max Matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            scanf("%d",&max[i][j]);

    printf("Available:\n");
    for(i=0;i<m;i++)
        scanf("%d",&avail[i]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            need[i][j]=max[i][j]-alloc[i][j];

    int finish[10]={0};

    printf("Safe Sequence: ");

    while(count<n) {
        int found=0;

        for(i=0;i<n;i++) {
            if(!finish[i]) {

                int flag=1;
                for(j=0;j<m;j++)
                    if(need[i][j]>avail[j])
                        flag=0;

                if(flag) {
                    printf("P%d ",i);

                    for(j=0;j<m;j++)
                        avail[j]+=alloc[i][j];

                    finish[i]=1;
                    found=1;
                    count++;
                }
            }
        }

        if(!found) {
            printf("\nUnsafe State\n");
            return 0;
        }
    }
}
